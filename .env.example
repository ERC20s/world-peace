# Example environment variables for local development or server configuration
# Number of days after which a page's "Sources last checked" date is considered stale.
# If unset or invalid, the validator defaults to 365.
SOURCES_MAX_AGE_DAYS=365

# Allow plain http:// sources in the validator when set to a truthy value (1, true, yes, on).
# By default the validator requires HTTPS for cited external sources.
#ALLOW_HTTP_SOURCES=1
